# Copy to .env on the machine that runs GD OS.
# Use a long random password on the café Windows server.
# Never commit .env.

POSTGRES_USER=gdos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gdos
POSTGRES_PORT=5432

API_PORT=8000
DATABASE_URL=postgresql+psycopg://gdos:change-me@postgres:5432/gdos

# Display timezone for the café. Billing timestamps stay UTC in the database.
CAFE_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Replace both values before the café server is used. change-me does not create an admin.
JWT_SECRET=change-me
JWT_TTL_HOURS=12
GD_OS_ADMIN_USERNAME=admin
GD_OS_ADMIN_PASSWORD=change-me
